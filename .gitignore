# rig rvenv start
# Everything in .rvenv is machine-specific output of `rig proj sync`; it can
# be deleted and rebuilt at any time. The committed rvenv shim package lives
# in .rvenvlib instead.
/.rvenv/
# rig rvenv end

# rig restores the build project's startup files during sync.
/.Renviron
/.rvenvlib/

/.codex/
/.direnv/
node_modules/
target/

# Nix
.envrc.local

# Rendered manual and local editorial checks
/docs/_site/
/docs/.quarto/
/.yomiyasu/
